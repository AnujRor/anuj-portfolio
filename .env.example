# Copy this file to `.env.local` and fill in your Supabase keys
# (Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Your live website address (no trailing slash) — used for canonical URLs, sitemap & social previews
VITE_SITE_URL=https://your-domain.com

# Optional: search engine ownership checks ("HTML tag" method). Paste only the content="..." value.
# Google Search Console -> Add property -> URL prefix -> HTML tag
VITE_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools -> Add site -> HTML Meta Tag
VITE_BING_SITE_VERIFICATION=
