# Copy this file to .env.local and fill in your values

# REQUIRED: Your production site URL (no trailing slash)
# This is used for sitemap.xml, robots.txt, canonical URLs, Open Graph images, etc.
VITE_SITE_URL=https://anujror.dev

# Supabase (optional - site works with static data.js fallback if missing)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# EmailJS (for contact form)
VITE_EMAILJS_PUBLIC_KEY=your-public-key
VITE_EMAILJS_SERVICE_ID=your-service-id
VITE_EMAILJS_TEMPLATE_ID=your-template-id

# Optional: Search Console verification
VITE_GOOGLE_SITE_VERIFICATION=your-google-verification-code
VITE_BING_SITE_VERIFICATION=your-bing-verification-code